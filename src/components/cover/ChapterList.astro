---
// The cover's contents page: all eight chapters, on the ivory band.
// Matches design/approved-mockup.html. The chapter details live in src/data/chapters.ts.
//
// Design note: reads like a report's contents page. Unwritten chapters stay visible but
// aren't clickable, so nothing leads to a dead end.
import { chapters, statusLabel } from '../../data/chapters';
---

<section class="bg-ivory py-14 md:py-20">
  <div class="mx-auto max-w-[1200px] px-4 md:px-10">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-heading-lg">Chapters</h2>
      <p class="text-caption text-steel">A new chapter is added at the end of each phase.</p>
    </div>

    <ol class="grid gap-2">
      {chapters.map((ch) => {
        // Written chapters are links; the rest are plain boxes. Same layout either way.
        const Tag = ch.href ? 'a' : 'div';
        return (
          <li>
            <Tag class:list={['ch', { 'is-link': ch.href }]} href={ch.href}>
              <span class="n">[{ch.n}]</span>
              <div>
                <h3>{ch.title}</h3>
                <p>{ch.summary}</p>
              </div>
              <span class:list={['tag', `tag-${ch.status}`]}><i></i>{statusLabel[ch.status].long}</span>
              <span class="arrow" aria-hidden="true">{ch.href ? '→' : ''}</span>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  /* ---------- One row ---------- */
  .ch {
    display: grid; grid-template-columns: 64px 1fr auto 28px; gap: 20px; align-items: center;
    padding: 22px 24px; border-radius: 8px; color: inherit; text-decoration: none;
  }
  .ch.is-link { background: rgba(255, 255, 255, 0.55); transition: background 160ms var(--ease-out-soft); }
  .ch.is-link:hover, .ch.is-link:focus-visible { background: var(--color-canvas-white); }

  .n { font: 400 13px var(--font-mono); color: var(--color-brass); }
  .ch h3 { font-size: 24px; line-height: 1.2; margin-bottom: 4px; }
  .ch:not(.is-link) h3 { color: var(--color-steel); } /* unwritten: quieter */
  .ch p { font-size: 15px; color: var(--color-steel); }

  .arrow { font: 400 20px var(--font-display); transition: transform 160ms var(--ease-out-soft); }
  .ch.is-link:hover .arrow { transform: translateX(4px); }

  /* ---------- Status tag ---------- */
  .tag {
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    font: 500 12px/1 var(--font-sans); color: var(--color-steel);
    background: var(--color-canvas-white); border-radius: 20px; padding: 6px 10px;
  }
  .tag i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-graphite); }
  .tag-collecting i { background: var(--color-brass); }
  .tag-build i { background: var(--color-ember); }   /* ember as a dot only, never text */
  .tag-planned i { background: transparent; box-shadow: inset 0 0 0 1px var(--color-slate); }

  /* ---------- Phones: number and text in two columns, tag below, no arrow ---------- */
  @media (max-width: 720px) {
    .ch { grid-template-columns: 36px 1fr; padding: 18px 14px; }
    .tag { grid-column: 2; justify-self: start; }
    .arrow { display: none; }
  }
</style>

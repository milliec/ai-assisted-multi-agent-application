---
// Chapter 01, section 1.3: three places where the team's own documents disagree.
// Source (capstone): project-context/1.define/mrd.md §2, the mismatch table
// ("Illustrative examples of the kind of mismatch found"). A-2 in the same file says it is
// not yet confirmed that these are mistakes rather than deliberate differences.
//
// Design note: a dumbbell chart shows the size of each disagreement at a glance.
// Each row has its own scale, labelled underneath.

interface Gap { name: string; measure: string; a: number; b: number; unit: string; max: number }

const gaps: Gap[] = [
  { name: 'Monthly report to the regulator', measure: 'Lead time in days', a: 3, b: 10, unit: 'days', max: 13 },
  { name: 'Annual report', measure: 'Lead time in days', a: 30, b: 120, unit: 'days', max: 130 },
];

// Where a value sits along its row, as a percentage of the row's scale
const pos = (value: number, max: number) => `${((value / max) * 100).toFixed(1)}%`;
---

<div class="dumb" data-reveal>
  {gaps.map((g) => (
    <div class="drow">
      <div class="name">{g.name}<small>{g.measure}</small></div>
      <!-- Screen readers get this sentence; the drawing below is hidden from them -->
      <p class="sr-only">One document says {g.a} {g.unit}. Another says {g.b} {g.unit}.</p>
      <div class="track" aria-hidden="true" style={`--a:${pos(g.a, g.max)}; --b:${pos(g.b, g.max)}`}>
        <span class="axis"></span>
        <span class="gap"></span>
        <span class="pt" style="left:var(--a)"></span>
        <span class="pl" style="left:var(--a)">{g.a} {g.unit}</span>
        <span class="pt pt-b" style="left:var(--b)"></span>
        <span class="pl" style="left:var(--b)">{g.b} {g.unit}</span>
        <span class="ax" style="left:0%">0</span>
        <span class="ax" style="left:100%">{g.max}</span>
      </div>
    </div>
  ))}

  <!-- The VAT example isn't a number, so it is shown as two answers side by side -->
  <div class="drow">
    <div class="name">VAT tax return<small>How the deadline is set</small></div>
    <p class="sr-only">One document says a fixed date. Another says 31 October after year end.</p>
    <div class="textcmp" aria-hidden="true"><span>A fixed date</span><em>≠</em><span>31 October after year end</span></div>
  </div>
</div>

<p class="caption">
  Examples from the project’s evidence note. Which answer is right is still open, and it is not yet
  confirmed that these are mistakes rather than real differences. The product’s job is to spot the
  disagreement and show it to a human specialist.
</p>

<style>
  .dumb { background: var(--color-canvas-white); border-radius: 20px; padding: 28px; margin-top: 32px; box-shadow: 0 0 0 1px var(--color-mist); }
  .drow {
    display: grid; grid-template-columns: 190px 1fr; gap: 24px; align-items: center;
    padding: 18px 0; border-top: 1px solid var(--color-fog);
  }
  .drow:first-child { border-top: 0; padding-top: 4px; }
  @media (max-width: 640px) { .drow { grid-template-columns: 1fr; gap: 10px; } }
  .name { font: 400 16px/1.25 var(--font-display); letter-spacing: -0.01em; }
  .name small { display: block; margin-top: 3px; font: 400 12px var(--font-sans); color: var(--color-steel); }

  /* ---------- One dumbbell ---------- */
  .track { position: relative; height: 48px; margin: 0 18px; }
  .axis { position: absolute; left: 0; right: 0; top: 24px; height: 1px; background: var(--color-mist); }
  /* The ember bar between the two answers: the size of the disagreement */
  .gap {
    position: absolute; top: 23px; height: 3px; background: var(--color-ember);
    left: var(--a); width: calc(var(--b) - var(--a));
    transition: width 900ms var(--ease-out-soft) 200ms;
  }
  /* Before the chart scrolls into view, the bar has no length (only when the reveal script runs) */
  :global(.reveal-ready:not(.is-in)) .gap { width: 0; }

  .pt {
    position: absolute; top: 18px; width: 13px; height: 13px; border-radius: 50%; transform: translateX(-50%);
    background: var(--color-canvas-white); box-shadow: inset 0 0 0 2px var(--color-graphite);
  }
  .pt-b { background: var(--color-brass); box-shadow: none; }
  .pl {
    position: absolute; top: -2px; transform: translateX(-50%); white-space: nowrap;
    font: 500 12px var(--font-sans); color: var(--color-graphite); font-variant-numeric: tabular-nums;
  }
  /* Scale labels: steel rather than the mockup's slate, so the small text passes contrast */
  .ax { position: absolute; top: 34px; transform: translateX(-50%); font: 400 10px var(--font-mono); color: var(--color-steel); }

  /* ---------- VAT: two answers side by side ---------- */
  .textcmp { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; font-size: 14px; }
  .textcmp span { background: var(--color-fog); border-radius: 8px; padding: 10px 12px; }
  .textcmp em { font-style: normal; font-size: 18px; color: var(--color-brass); }

  .caption { max-width: 680px; margin-top: 12px; font-size: 13px; line-height: 1.45; color: var(--color-steel); }
</style>

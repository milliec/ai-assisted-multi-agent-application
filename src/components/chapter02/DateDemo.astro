---
// Chapter 02, section 2.5: a SIMULATION of the planned date code (not built yet).
// Sources (capstone, project-context/1.define/mock-data/expected-obligation-library.md):
//   §4 OBL-01: month-end 2026-12-31 + 10 days = 2027-01-10 (Sunday), rolled to Mon 2027-01-11.
//   D-4: each report has its own weekend rule (roll forward / no roll / not confirmed).
//   D-5: regulator reports roll forward; tax deadlines don't. The monthly report's rule is roll forward.
//   D-6: not confirmed = keep the earlier, unrolled date and mark it.
//
// Design note: the visitor changes the rule, not the model, and sees the same input give the
// same answer every time.

// January 2027 for the little calendar. 1 January 2027 is a Friday.
const weekday = (d: number) => new Date(Date.UTC(2027, 0, d)).getUTCDay(); // 0 = Sunday
const leadingBlanks = (weekday(1) + 6) % 7; // Monday-first grid
const days = Array.from({ length: 31 }, (_, i) => i + 1);

const rules = [
  {
    value: 'roll', label: 'Move to next working day', due: 11, dueText: 'Mon 11 Jan 2027',
    note: 'Sunday isn’t a working day, so the deadline moves to Monday. This is the monthly report’s actual rule.',
  },
  {
    value: 'keep', label: 'Keep the date', due: 10, dueText: 'Sun 10 Jan 2027',
    note: 'This rule keeps the deadline where it falls, even on a weekend. Tax deadlines work this way.',
  },
  {
    value: 'unconfirmed', label: 'Not confirmed', due: 10, dueText: 'Sun 10 Jan 2027',
    note: 'Nobody has confirmed the rule yet, so the earlier date is kept and marked for a human specialist. Filing early is safe; filing late is not.',
  },
];
---

<div class="stage wide" data-date-demo>
  <div class="mb-[18px] flex flex-wrap items-center justify-between gap-3">
    <p class="font-display text-[13px] leading-[1.38] tracking-[-0.01em] text-brass">Simulation · the planned date code · monthly report for December 2026</p>
    <span class="tag">No AI involved</span>
  </div>

  <div class="datedemo">
    <div class="calc">
      <div class="line"><span>Start date (end of the month)</span><b>Thu 31 Dec 2026</b></div>
      <div class="line"><span>Time allowed</span><b>+ 10 days</b></div>
      <div class="line"><span>Falls on</span><b>Sun 10 Jan 2027</b></div>

      <fieldset class="rule-pick">
        <legend>Weekend rule</legend>
        <div class="seg-ctl">
          {rules.map((r, i) => (
            <label>
              <input type="radio" name="weekend-rule" value={r.value} checked={i === 0}
                data-due={r.due} data-due-text={r.dueText} data-note={r.note} />
              <span>{r.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="line result">
        <span>Due date</span>
        <span class="text-right">
          <b data-due-out aria-live="polite">{rules[0].dueText}</b>
          <span class="flag" data-flag hidden>roll rule unconfirmed</span>
        </span>
      </div>
      <p class="rule-note" data-note-out>{rules[0].note}</p>
    </div>

    <!-- The calendar repeats what the text above says, so screen readers skip it -->
    <div class="cal" aria-hidden="true">
      <div class="mb-3 flex justify-between font-display text-[15px]">
        <span>January 2027</span><span class="font-mono text-[12px] text-steel">Monthly report</span>
      </div>
      <div class="cal-g">
        {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d) => <span class="dow">{d}</span>)}
        {Array.from({ length: leadingBlanks }, () => <span></span>)}
        {days.map((d) => (
          <span
            class:list={['d', { we: weekday(d) === 0 || weekday(d) === 6, 'falls-on': d === 10, rolled: d === 10, due: d === 11 }]}
            data-day={d}
          >{d}</span>
        ))}
      </div>
      <div class="cal-legend">
        <span><i class="ring"></i>Falls on</span><span><i class="fill"></i>Due</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Switching the weekend rule updates the due date, the note and the calendar highlight.
  const demo = document.querySelector<HTMLElement>('[data-date-demo]');
  if (demo) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const radios = [...demo.querySelectorAll<HTMLInputElement>('input[name="weekend-rule"]')];
    const update = (input: HTMLInputElement) => {
      const due = Number(input.dataset.due);
      demo.querySelector('[data-due-out]')!.textContent = input.dataset.dueText!;
      demo.querySelector('[data-note-out]')!.textContent = input.dataset.note!;
      (demo.querySelector('[data-flag]') as HTMLElement).hidden = input.value !== 'unconfirmed';
      demo.querySelectorAll<HTMLElement>('[data-day]').forEach((cell) => {
        const day = Number(cell.dataset.day);
        cell.classList.toggle('rolled', day === 10 && due !== 10);
        const isDue = day === due;
        cell.classList.toggle('due', isDue);
        // Replay the little "pop" on the new due day
        if (isDue && !reduceMotion) { cell.classList.remove('pop'); void cell.offsetWidth; cell.classList.add('pop'); }
      });
    };
    radios.forEach((r) => r.addEventListener('change', () => update(r)));
  }
</script>

<style>
  .tag {
    display: inline-flex; white-space: nowrap; padding: 6px 10px; border-radius: 20px;
    font: 500 12px/1 var(--font-sans); color: var(--color-steel); background: var(--color-canvas-white);
  }
  .datedemo { display: grid; grid-template-columns: 1fr 290px; gap: 24px; align-items: start; }
  @media (max-width: 760px) { .datedemo { grid-template-columns: 1fr; } }

  /* ---------- The calculation ---------- */
  .calc { padding: 8px 22px 18px; border-radius: 20px; background: var(--color-canvas-white); font-size: 14px; }
  .line { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--color-fog); }
  .line > span:first-child { color: var(--color-steel); }
  .line b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .result { padding-top: 16px; border-bottom: 0; align-items: baseline; }
  .result b { display: block; font: 400 24px var(--font-display); letter-spacing: -0.02em; }
  .flag {
    display: inline-block; margin-top: 6px; padding: 4px 8px; border-radius: 20px;
    background: var(--color-ivory); font: 500 11px/1 var(--font-sans); color: var(--color-graphite);
  }
  .flag[hidden] { display: none; }
  .rule-note { font-size: 13px; line-height: 1.4; color: var(--color-steel); }

  /* Segmented control: real radio buttons, styled as joined boxes */
  .rule-pick { margin: 14px 0 4px; border: 0; padding: 0; min-width: 0; }
  .rule-pick legend { margin-bottom: 6px; font-size: 13px; color: var(--color-graphite); }
  .seg-ctl { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--color-graphite); }
  .seg-ctl label { position: relative; cursor: pointer; }
  .seg-ctl input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .seg-ctl span { display: block; padding: 8px 14px; font: 400 14px var(--font-display); transition: background 160ms, color 160ms; }
  .seg-ctl input:checked + span { background: var(--color-graphite); color: #fff; }
  .seg-ctl input:focus-visible + span { outline: 2px solid var(--color-graphite); outline-offset: 2px; }
  /* Narrow screens: the three options stack as a list instead of wrapping unevenly */
  @media (max-width: 600px) {
    .seg-ctl { display: grid; width: 100%; }
    .seg-ctl label + label span { border-top: 1px solid var(--color-graphite); }
  }

  /* ---------- The little calendar ---------- */
  .cal { padding: 18px; border-radius: 20px; background: var(--color-canvas-white); }
  .cal-g { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
  .dow { padding-bottom: 6px; font-size: 11px; color: var(--color-steel); }
  .d { display: grid; place-items: center; aspect-ratio: 1; border-radius: 50%; }
  .we { background: var(--color-fog); color: var(--color-steel); }
  .falls-on { box-shadow: inset 0 0 0 1px var(--color-graphite); background: transparent; color: var(--color-graphite); }
  /* When the date moves: the original day is struck through with an ember line */
  .falls-on.rolled { box-shadow: inset 0 0 0 1px var(--color-steel); color: var(--color-steel); text-decoration: line-through; text-decoration-color: var(--color-ember); }
  .due { background: var(--color-graphite); color: #fff; }
  .falls-on.due { box-shadow: none; }
  .pop { animation: pop 360ms var(--ease-out-soft); }
  @keyframes pop { 0% { transform: scale(0.6); } 70% { transform: scale(1.08); } 100% { transform: scale(1); } }
  .cal-legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; font-size: 11px; color: var(--color-steel); }
  .cal-legend i { display: inline-block; width: 10px; height: 10px; margin-right: 5px; border-radius: 50%; vertical-align: -1px; }
  .cal-legend .ring { box-shadow: inset 0 0 0 1px var(--color-graphite); }
  .cal-legend .fill { background: var(--color-graphite); }
</style>

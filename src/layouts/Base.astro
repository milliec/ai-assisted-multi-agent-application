---
// The shared page shell. Every page wraps its content in <Base>.
// It loads the self-hosted fonts and the global stylesheet once, so pages don't have to.

// Fonts (self-hosted: visitors' browsers never contact a font service)
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/global.css';
import NavPill from '../components/NavPill.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A case study: an AI tool that drafts a fund’s reporting calendar, with a human specialist approving every rule.',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Hidden until a keyboard user presses Tab: jumps past the header to the content -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <!-- The glass pill: the site's only navigation -->
    <NavPill />

    <script>
      // Reveal on scroll: see the note in src/styles/global.css.
      // Visitors who asked for reduced motion see everything straight away.
      const items = document.querySelectorAll('[data-reveal]');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const watcher = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              watcher.unobserve(entry.target); // only reveal once
            }
          }),
          { threshold: 0.3 } // when 30% of the element is on screen
        );
        items.forEach((el) => { el.classList.add('reveal-ready'); watcher.observe(el); });
      }
    </script>
  </body>
</html>

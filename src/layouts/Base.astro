---
// The shared page shell. Every page wraps its content in <Base>.
// It loads the self-hosted fonts and the global stylesheet once, so pages don't have to.

// Fonts (self-hosted: visitors' browsers never contact a font service)
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A case study: an AI tool that drafts a fund’s reporting calendar, with a human specialist approving every rule.',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

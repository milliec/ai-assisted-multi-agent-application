---
// The chapter template. Every chapter page wraps its sections in <Chapter ...>.
// The page supplies the words; this file supplies the frame:
//   ivory header (breadcrumb, title, intro, meta, "at a glance" box)
//   two-column reader: sticky "On this page" menu + the article
//   "Next chapter" card, then the shared header and footer.
// Matches the chapter pages in design/approved-mockup.html.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  n: string;                                   // chapter number, e.g. '01'
  title: string;
  lede: string;                                // the intro paragraph under the title
  readingTime: string;                         // e.g. '5 min'
  phase: string;                               // which project phase the chapter covers
  glance: { value: string; label: string }[];  // the three "at a glance" numbers
  toc: { id: string; label: string }[];        // sections, in order (ids match <section id>)
  // The next chapter. With href it is a link; without one (not written yet) it is a quiet,
  // unclickable card, and `note` replaces "Next chapter" (e.g. "Added each sprint").
  next?: { n: string; title: string; href?: string; note?: string };
}

const { n, title, lede, readingTime, phase, glance, toc, next } = Astro.props;
---

<Base title={`${title} · Chapter ${n} · Case study`}>
  <SiteHeader />

  <main id="main">
    <!-- ============ Chapter header (ivory) ============ -->
    <section class="bg-ivory pt-14 pb-16">
      <div class="ch-hero mx-auto max-w-[1200px] px-4 md:px-10">
        <nav aria-label="Breadcrumb" class="flex gap-2 font-display text-[13px] text-steel">
          <a href="/" class="ul">Case study</a><span aria-hidden="true">/</span><span class="font-mono text-brass">[{n}]</span>
        </nav>
        <h1 class="my-6 max-w-[13em] text-[clamp(40px,5.4vw,66px)] leading-[0.95]">{title}</h1>
        <p class="max-w-[36em] text-[18px] leading-[1.45] text-steel">{lede}</p>
        <div class="mt-7 flex flex-wrap gap-7 text-[13px] text-steel">
          <span>Reading time<b class="ml-1.5 font-medium text-graphite">{readingTime}</b></span>
          <span>Phase<b class="ml-1.5 font-medium text-graphite">{phase}</b></span>
        </div>

        <!-- Design note: three numbers sum up the chapter before you read it,
             and fill the space beside the title. -->
        <dl class="glance">
          {glance.map((g) => (
            <div><dt>{g.value}</dt><dd>{g.label}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ Reader: menu + article ============ -->
    <div class="reader mx-auto max-w-[1200px] px-4 md:px-10">
      <nav class="toc" aria-label="On this page">
        <p class="mb-3.5 font-display text-[13px] leading-[1.38] tracking-[-0.01em] text-brass">On this page</p>
        <ol>
          {toc.map((item, i) => (
            <li>
              <a href={`#${item.id}`}><span class="num">{n.replace(/^0/, '')}.{i + 1}</span>{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <article class="article">
        <slot />

        {next && next.href && (
          <a class="next" href={next.href}>
            <div>
              <small><span class="font-mono">[{next.n}]</span> {next.note ?? 'Next chapter'}</small>
              <h3>{next.title}</h3>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
        {next && !next.href && (
          <div class="next next-off">
            <div>
              <small><span class="font-mono">[{next.n}]</span> {next.note ?? 'Coming later'}</small>
              <h3>{next.title}</h3>
            </div>
          </div>
        )}
      </article>
    </div>
  </main>

  <SiteFooter />
</Base>

<script>
  // "On this page" menu:
  //  1. highlights the section you are reading (an IntersectionObserver watches each section)
  //  2. fills a thin line down the menu to show how far through the chapter you are
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const article = document.querySelector<HTMLElement>('.article');
  const list = document.querySelector<HTMLElement>('.toc ol');

  if (links.length && article && list) {
    const setActive = (id: string) =>
      links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${id}`));
    setActive(links[0].getAttribute('href')!.slice(1));

    // A section counts as "being read" when it crosses a band 25–35% down the screen
    const spy = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
      { rootMargin: '-25% 0px -65% 0px' }
    );
    article.querySelectorAll('section[id]').forEach((s) => spy.observe(s));

    const updateProgress = () => {
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.35 - r.top) / r.height));
      list.style.setProperty('--p', p.toFixed(3));
    };
    addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>

<style>
  /* ---------- Header: text on the left, "at a glance" box bottom-right ---------- */
  .ch-hero { display: grid; grid-template-columns: minmax(0, 1fr) 280px; column-gap: 60px; }
  .ch-hero > *:not(.glance) { grid-column: 1; }
  .glance {
    grid-column: 2; grid-row: 1 / span 4; align-self: end;
    background: var(--color-canvas-white); border-radius: 20px; padding: 8px 24px;
  }
  .glance > div {
    display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: baseline;
    padding: 16px 0; border-top: 1px solid var(--color-fog);
  }
  .glance > div:first-child { border-top: 0; }
  .glance dt { font: 400 40px/1 var(--font-display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .glance dd { font-size: 14px; line-height: 1.4; color: var(--color-steel); }
  @media (max-width: 900px) {
    .ch-hero { grid-template-columns: 1fr; }
    .glance { grid-column: 1; grid-row: auto; margin-top: 32px; }
  }

  /* ---------- Reader: menu column + article column ---------- */
  .reader {
    display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 56px;
    padding-top: 72px; padding-bottom: 80px;
  }
  @media (max-width: 1140px) { .reader { grid-template-columns: 180px minmax(0, 1fr); gap: 44px; } }
  @media (max-width: 860px) { .reader { grid-template-columns: minmax(0, 1fr); padding-bottom: 56px; } .toc { display: none; } }

  /* Sticky menu: stays 32px from the top of the screen while you scroll */
  .toc { position: sticky; top: 32px; align-self: start; font-size: 14px; }
  .toc ol { position: relative; border-left: 1px solid var(--color-mist); }
  /* The progress line: its height is set by the script (--p goes from 0 to 1) */
  .toc ol::before {
    content: ""; position: absolute; left: -1px; top: 0; width: 1px;
    height: calc(var(--p, 0) * 100%); background: var(--color-graphite);
  }
  .toc a {
    position: relative; display: grid; grid-template-columns: 30px 1fr;
    padding: 7px 0 7px 14px; line-height: 1.35; color: var(--color-steel); text-decoration: none;
    transition: color 160ms var(--ease-out-soft);
  }
  .toc a:hover, .toc a.active { color: var(--color-graphite); }
  .toc .num { font: 400 11px var(--font-mono); color: var(--color-steel); padding-top: 2px; }
  /* Ember marker beside the section you are reading */
  .toc a::before {
    content: ""; position: absolute; left: -2px; top: 6px; bottom: 6px; width: 3px;
    background: var(--color-ember); transform: scaleY(0);
    transition: transform 320ms var(--ease-out-soft);
  }
  .toc a.active::before { transform: scaleY(1); }

  /* ---------- "Next chapter" card ---------- */
  .next {
    display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 16px;
    padding: 36px 40px; background: var(--color-ivory); border-radius: 6px 0 0 0;
    color: inherit; text-decoration: none;
  }
  .next small { display: block; margin-bottom: 10px; font: 400 13px var(--font-display); color: var(--color-brass); }
  .next h3 { font-size: 36px; line-height: 1.1; }
  .next .arrow { font: 400 36px var(--font-display); transition: transform 320ms var(--ease-out-soft); }
  .next:hover .arrow { transform: translateX(8px); }
  /* Not written yet: grey card, quieter title, no arrow */
  .next-off { background: var(--color-fog); }
  .next-off h3 { color: var(--color-steel); }
  @media (max-width: 720px) { .next { padding: 24px; } .next h3 { font-size: 28px; } }
</style>

<!-- Article text styles. "is:global" because the sections come from each chapter page,
     and Astro's normal styles only reach elements written in this file. All are kept
     inside .article so they can't leak anywhere else. -->
<style is:global>
/* Inside @layer base, so these are defaults: a Tailwind class on an element
   (e.g. text-brass on a paragraph) still wins over them. */
@layer base {
  .article section { scroll-margin-top: 32px; margin-bottom: 104px; }
  .article h2 {
    display: flex; gap: 14px; align-items: baseline;
    font-size: 32px; line-height: 1.19; margin-bottom: 20px;
  }
  .article h2 .num { font: 400 13px var(--font-mono); color: var(--color-brass); }
  .article p { font-size: 17px; line-height: 1.65; color: var(--color-steel); }
  .article p + p { margin-top: 1em; }
  .article p strong { color: var(--color-graphite); font-weight: 500; }
  .article p.first { font-size: 19px; line-height: 1.55; color: var(--color-graphite); }
  /* Text keeps a comfortable line length (about 70 characters); visuals use the full column */
  .article section > h2, .article section > p { max-width: 680px; }

  /* Stage: the ash panel that holds visuals and demos */
  .article .stage { background: var(--color-ash); border-radius: 6px 0 0 0; padding: 40px; margin: 32px 0; }
  @media (max-width: 720px) { .article .stage { padding: 16px; } }
  /* On phones, panels marked "wide" run edge to edge (cancelling the 16px page gutter) */
  @media (max-width: 860px) { .article .wide { margin-left: -16px; margin-right: -16px; } }
}
</style>
